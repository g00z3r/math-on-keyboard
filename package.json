{
  "name": "math-on-keyboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node scripts/smoke-production.mjs",
    "probe:math": "node scripts/probe-mathlive.mjs",
    "probe:progressive": "node scripts/probe-progressive-math.mjs",
    "probe:origin-groups": "node scripts/probe-origin-groups.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "mathlive": "0.111.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "6.4.6",
    "vitest": "^5.1.0"
  }
}
